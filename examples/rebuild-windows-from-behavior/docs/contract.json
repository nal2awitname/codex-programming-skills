{
  "schema_version": 1,
  "project": {
    "name": "RangeTotalsCLI",
    "platform": "Windows CLI; Python 3.10+; host verification required"
  },
  "requirements": [
    {
      "id": "REQ-001",
      "description": "A parsed request must be an object containing exactly the property values. Missing or additional properties, or a non-object request, return the JSON object with error equal to invalid_request. This shape check takes precedence over validation of the value.",
      "evidence_status": "observed",
      "evidence_ids": [
        "OBS-007",
        "OBS-012",
        "OBS-020",
        "OBS-039"
      ]
    },
    {
      "id": "REQ-002",
      "description": "The values property must be an array whose elements are JSON integers. Reject booleans, null, strings, objects, nested arrays, decimal tokens and exponential tokens, including numerically integral decimal tokens, by returning error equal to integer_list_required.",
      "evidence_status": "observed",
      "evidence_ids": [
        "OBS-006",
        "OBS-008",
        "OBS-010",
        "OBS-011",
        "OBS-014",
        "OBS-023",
        "OBS-033"
      ]
    },
    {
      "id": "REQ-003",
      "description": "For a nonempty valid array, return exactly count, span and total: the number of supplied elements, the difference between the greatest and least supplied integer, and the exact sum. Duplicates and order do not change these definitions.",
      "evidence_status": "observed",
      "evidence_ids": [
        "OBS-001",
        "OBS-003",
        "OBS-004",
        "OBS-005",
        "OBS-031"
      ]
    },
    {
      "id": "REQ-004",
      "description": "For an empty valid array, return count equal to 0, span equal to JSON null, and total equal to 0.",
      "evidence_status": "observed",
      "evidence_ids": [
        "OBS-002"
      ]
    },
    {
      "id": "REQ-005",
      "description": "Preserve exact integer arithmetic for the exercised large integer inputs, including values with magnitude 10 to the power 100 and a span twice that magnitude. No supported fixed-width or floating-point rounding is allowed for those examples; unmeasured extreme limits remain unknown.",
      "evidence_status": "observed",
      "evidence_ids": [
        "OBS-018",
        "OBS-026"
      ]
    },
    {
      "id": "REQ-006",
      "description": "The CLI reads JSON text from the first command argument. Surrounding JSON whitespace is accepted. Missing, empty or malformed JSON text returns error equal to invalid_json.",
      "evidence_status": "observed",
      "evidence_ids": [
        "OBS-028",
        "OBS-029",
        "OBS-031",
        "OBS-036"
      ]
    },
    {
      "id": "REQ-007",
      "description": "When more than one command argument is supplied, process only the first and ignore later arguments.",
      "evidence_status": "observed",
      "evidence_ids": [
        "OBS-030"
      ]
    },
    {
      "id": "REQ-008",
      "description": "Each exercised CLI invocation emits exactly one JSON object followed by a newline, emits no stderr, and exits with status 0, including the defined input error responses. JSON object property order and insignificant serialization whitespace are not compatibility requirements. Test inputs are envelopes containing arguments; expected outputs contain stdout_json, exit_code and stderr.",
      "evidence_status": "observed",
      "evidence_ids": [
        "OBS-001",
        "OBS-006",
        "OBS-028",
        "OBS-029",
        "OBS-030"
      ]
    }
  ],
