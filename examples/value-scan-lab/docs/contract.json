{
  "schema_version": 1,
  "project": {
    "name": "ValueScanLab",
    "platform": "Windows; portable CLI on Python 3.10+"
  },
  "requirements": [
    {
      "id": "REQ-001",
      "description": "An initial exact-value search returns every aligned location currently equal to the requested integer.",
      "evidence_status": "public-spec-confirmed",
      "evidence_ids": [
        "SPEC-001"
      ]
    },
    {
      "id": "REQ-002",
      "description": "A subsequent exact-value search retains only matching locations from the immediately preceding result set; newly matching locations outside that set are not added.",
      "evidence_status": "public-spec-confirmed",
      "evidence_ids": [
        "SPEC-001"
      ]
    },
    {
      "id": "REQ-003",
      "description": "Subsequent changed, unchanged, increased and decreased searches compare current values with values retained by the immediately preceding completed scan, using strict inequality for increased/decreased.",
      "evidence_status": "public-spec-confirmed",
      "evidence_ids": [
        "SPEC-002"
      ]
    },
    {
      "id": "REQ-004",
      "description": "An initial unknown-value search retains all available four-byte integer locations for later refinement.",
      "evidence_status": "public-spec-confirmed",
      "evidence_ids": [
        "SPEC-001"
      ]
    },
    {
      "id": "REQ-005",
      "description": "Use signed 32-bit little-endian integer slots, byte offsets in ascending order, and reject booleans, nonintegers and integers outside the signed 32-bit range. Offsets and strict validation are new lab interface choices.",
      "evidence_status": "proposed",
      "evidence_ids": [
        "DESIGN-001",
        "SPEC-001"
      ]
    },
    {
      "id": "REQ-006",
      "description": "A new initial search starts a fresh result set; reset clears scan state. Refinement before any initial scan is an error. Unknown-value mode is available for the initial search only.",
      "evidence_status": "proposed",
      "evidence_ids": [
        "DESIGN-002",
        "SPEC-001"
      ]
    },
    {
      "id": "REQ-007",
      "description": "Allocate and scan only a small buffer owned by this application. The demonstration starts with [137,20,137,-3,137,0], changes slot 2 to 120, and narrows the original three matches to byte offset 8. No arbitrary process attachment or reference-program dependency is part of this lab.",
      "evidence_status": "proposed",
      "evidence_ids": [
        "DESIGN-003"
      ]
    },
    {
      "id": "REQ-008",
      "description": "Provide a Python 3.10+ standard-library CLI: --demo emits the documented demonstration as JSON; --scenario FILE evaluates the neutral scenario interface. Use history entries only for first/next scans; each entry has offsets and their current values. Invalid scenarios return a named error object and a nonzero exit status.",
      "evidence_status": "proposed",
      "evidence_ids": [
        "DESIGN-004"
      ]
    },
    {
      "id": "REQ-009",
      "description": "Provide an original desktop interface for the owned-buffer demonstration with a search value, scan mode, initial-search button, refine button, lower-sample-value button, restart button and a results table. Lower sample subtracts 17 from slot 2; restart restores the initial fixture and clears results. Keep this lab identity distinct from any reference application.",
      "evidence_status": "proposed",
      "evidence_ids": [
        "DESIGN-005"
      ]
    }
  ],
