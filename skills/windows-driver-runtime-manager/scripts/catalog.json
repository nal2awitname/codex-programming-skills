      "vendor": "Dell",
      "match": "^(Dell|Alienware)",
      "modelExclude": "Alienware",
      "name": "Dell Command | Update",
      "winget": "Dell.CommandUpdate",
      "automated": true,
      "exe": [
        "%ProgramFiles%\\Dell\\CommandUpdate\\dcu-cli.exe",
        "%ProgramFiles(x86)%\\Dell\\CommandUpdate\\dcu-cli.exe"
      ],
      "scanArgs": "/scan -silent -report=\"{ReportDir}\" -outputLog=\"{LogFile}\"",
      "applyArgs": "/applyUpdates -silent -reboot=disable -autoSuspendBitLocker=enable -outputLog=\"{LogFile}\"",
      "report": "dell",
      "successCodes": [0, 1, 5, 500],
      "rebootCodes": [1, 5],
      "noUpdateCodes": [500],
      "supportUrl": "https://www.dell.com/support/home/",
      "note": "ติดตั้ง BIOS ชิปเซ็ต และไดรเวอร์ทั้งหมดตามลำดับที่ Dell กำหนดให้อัตโนมัติ (ระงับ BitLocker ระหว่างอัปเดต BIOS)"
